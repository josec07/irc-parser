# Copy to .env and fill in. Do not commit .env.

# Required. Sent only as an HTTP header, never in the URL.
IRCP_API_KEY=change-me-to-a-long-random-string

# Login of the Twitch account that granted the token. Not a display name.
TWITCH_NICK=your_bot_login

# User access token with chat:read only. oauth: prefix is optional.
# Do not request chat:edit. This process never sends chat.
TWITCH_OAUTH_TOKEN=

# Optional. Comma-separated logins or https://twitch.tv/<channel> URLs.
# Only channels you operate, or have permission to analyze.
IRCP_CHANNELS=yourchannel

# Rolling in-memory window. 60-86400. Default 900. Not written to disk.
IRCP_WINDOW_SECONDS=900

# 1-100. Twitch's concurrent join limit for a normal account is 100.
IRCP_MAX_CHANNELS=20

# Host runs should stay on localhost. Compose overrides this to 0.0.0.0
# inside the container and publishes 127.0.0.1:8080 on the host.
IRCP_BIND=127.0.0.1
IRCP_PORT=8080

# debug, info, warn, error
IRCP_LOG_LEVEL=info
